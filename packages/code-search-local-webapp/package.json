{
  "name": "@code-search-local/code-search-local-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "pnpm --filter @code-search-local/code-search-local-api run generate && tsc -b tsconfig.json",
    "build": "pnpm run compile && pnpm run build:webpack",
    "build:webpack": "webpack --config etc/webpack/webpack.prod.mjs",
    "dev": "webpack serve --config etc/webpack/webpack.dev.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "playwright test --config etc/playwright/playwright.config.ts",
    "clean": "rm -rf lib dist"
  },
  "dependencies": {
    "@3fv/prelude-ts": "^0.8.42",
    "@code-search-local/code-search-local-api": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-tree-view": "^9.15.0",
    "@reduxjs/toolkit": "^2.13.0",
    "lodash-es": "^4.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "get-port": "^7.2.0",
    "html-webpack-plugin": "^5.6.8",
    "jest-environment-jsdom": "30.5.2",
    "jest-fixed-jsdom": "^0.0.11",
    "react-refresh": "^0.19.0",
    "react-refresh-typescript": "^2.0.12",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
